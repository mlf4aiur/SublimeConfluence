/*
    Confluence default settings
*/
{
    /*
        Sets the Confluence REST url base
    */
    "base_uri": "https://confluence.example.com/confluence/rest/api",

    /*
        Sets the default Confluence space
    */
    "default_space_key": null,

    /*
        Sets the Confluence username
    */
    "username": null,

    /*
        Sets the Confluence password
    */
    "password": null,

    /*
        Verifies TLS certificates. Set to a CA bundle path to use a custom
        certificate authority, for example:
        "verify_ssl": "/path/to/company-ca-bundle.pem"
        Disabling verification is not recommended.
    */
    "verify_ssl": true
}
